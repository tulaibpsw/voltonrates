# MongoDB Atlas (free M0). Database name defaults to volton_rates.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=volton_rates

# Admin login (the owner). Change the password any time; it logs every device out.
ADMIN_PASSWORD=change-me
# Random 32+ characters. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Pusher Channels (free Sandbox plan) for instant updates. Leave empty to use 10-second auto refresh.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Cloudinary (the client's free account — same keys as the Volt On CRM) for notice pictures/videos.
# Without these, the admin can still paste an https:// picture/video link.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
